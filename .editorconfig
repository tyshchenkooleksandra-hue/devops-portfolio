# Спільні налаштування редактора для проєктів курсу.
# Пояснення кожного значення — docs/editor-config.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# YAML/JSON: відступ змістовний (визначає структуру), фіксуємо явно, а не через [*]
[*.{yml,yaml,json}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.sh]
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
